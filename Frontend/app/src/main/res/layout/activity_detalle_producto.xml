<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".ui.producto.DetalleProductoActivity"
    android:fillViewport="true"
    android:id="@+id/scrolldetalleProducto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/mesajil_white"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="Detalle del producto"
            app:titleTextColor="@color/text_primary"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_margin="@dimen/spacing_large"
            app:cardCornerRadius="@dimen/corner_radius_large"
            app:cardElevation="@dimen/card_elevation">

            <ImageView
                android:id="@+id/imgProducto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:src="@drawable/logomesajil"/>
        </com.google.android.material.card.MaterialCardView>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_large">

            <TextView
                android:id="@+id/txtNombre"
                style="@style/ProductName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Laptop Lenovo Thinkpad"/>
            <TextView
                android:id="@+id/txtMarca"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:text="Marca: Lenovo"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_medium"/>
            <TextView
                android:id="@+id/txtModelo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Modelo: LOQ 15IRX9"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_medium"/>
            <RatingBar
                android:id="@+id/ratingProducto"
                style="?android:attr/ratingBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:isIndicator="true"
                android:numStars="5"
                android:stepSize="0.5"/>
            <TextView
                android:id="@+id/txtPrecio"
                style="@style/ProductPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:text="S/. 2,999.90"/>
            <TextView
                android:id="@+id/txtStock"
                style="@style/ProductStock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Disponible: 10 unidades"/>
        </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="@dimen/spacing_large"
                android:layout_marginTop="@dimen/spacing_large"
                android:background="@color/divider"/>
<!--            Descripción del producto-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_large">
                <TextView
                    style="@style/SectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Descripción"/>
                <TextView
                    android:id="@+id/txtDescripcion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:lineSpacingExtra="4dp"
                    android:text="Laptop empresarial con procesador Intel Core i7, memoria RAM de 16GB, almacenamiento SSD de 512GB y pantalla Full HD de 15.6 pulgadas."
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_medium"/>
            </LinearLayout>
<!--                Selector de cantidad de producto-->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="@dimen/spacing_large"
                    android:background="@color/divider"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_large">
                    <TextView
                        style="@style/SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cantidad"/>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_medium"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="horizontal">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnMenos"
                            android:layout_width="50dp"
                            android:layout_height="48dp"
                            app:icon="@drawable/ic_remove"
                            app:iconTint="@android:color/white"
                            android:text=""
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            android:insetRight="0dp"
                            android:insetLeft="0dp"
                            android:minWidth="48dp"
                            android:textSize="22sp"/>
                        <TextView
                            android:id="@+id/txtCantidad"
                            android:layout_width="72dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="1"
                            android:textStyle="bold"
                            android:textSize="20sp"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnMas"
                            android:layout_width="50dp"
                            android:layout_height="48dp"
                            app:icon="@drawable/ic_add"
                            app:iconTint="@android:color/white"
                            android:text=""
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            android:insetRight="0dp"
                            android:insetLeft="0dp"
                            android:minWidth="48dp"
                            android:textSize="22sp"/>
                    </LinearLayout>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAgregarCarrito"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="@dimen/spacing_large"
                            android:layout_marginTop="@dimen/spacing_large"
                            android:text="Agregar al carrito"
                            android:textAllCaps="false"
                            app:icon="@drawable/ic_cart"
                            app:iconGravity="textStart"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnComprar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/spacing_large"
                            android:text="Comprar ahora"
                            android:textAllCaps="false"
                            android:backgroundTint="@color/mesajil_blue_dark"/>
                    </LinearLayout>
                </LinearLayout>
</androidx.core.widget.NestedScrollView>