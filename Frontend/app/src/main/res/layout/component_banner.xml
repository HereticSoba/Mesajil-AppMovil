<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="170dp"
    android:layout_marginHorizontal="@dimen/spacing_large"
    android:layout_marginVertical="@dimen/spacing_medium"
    app:cardCornerRadius="@dimen/corner_radius_large"
    app:cardElevation="@dimen/card_elevation"
    app:cardBackgroundColor="@color/mesajil_blue">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_large"
        android:gravity="center_vertical">

        <!-- Texto -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtOferta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔥 Hasta 40% OFF"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="24sp"/>

            <TextView
                android:id="@+id/txtDescripcion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:text="Encuentra laptops, monitores y accesorios al mejor precio."
                android:textColor="@android:color/white"
                android:textSize="@dimen/text_medium"
                android:maxLines="3"
                android:ellipsize="end"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnComprar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginTop="@dimen/spacing_medium"
                android:text="Conocer más"
                android:textAllCaps="false"
                android:textColor="@color/mesajil_blue"
                app:backgroundTint="@android:color/white"/>
        </LinearLayout>
        <!-- Imagen -->
        <ImageView
            android:id="@+id/imgBanner"
            android:layout_width="0dp"
            android:layout_height="90dp"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/spacing_medium"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/logomesajil"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>